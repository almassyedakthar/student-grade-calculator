#include <stdio.h>

int main() {
    int marks[5];
    int total = 0;
    float average;
    char grade;

    printf("===== STUDENT GRADE CALCULATOR =====\n\n");

    for (int i = 0; i < 5; i++) {
        printf("Enter marks for Subject %d: ", i + 1);
        scanf("%d", &marks[i]);
        total += marks[i];
    }

    average = total / 5.0;

    if (average >= 90)
        grade = 'A';
    else if (average >= 80)
        grade = 'B';
    else if (average >= 70)
        grade = 'C';
    else if (average >= 60)
        grade = 'D';
    else
        grade = 'F';

    printf("\n===== RESULT =====\n");
    printf("Total Marks : %d / 500\n", total);
    printf("Average     : %.2f\n", average);
    printf("Grade       : %c\n", grade);

    return 0;
}
